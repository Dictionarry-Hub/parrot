# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here
GUILD_ID=your_development_guild_id_here  # Optional: For dev, speeds up command registration

# Channel IDs (Get these by right-clicking a channel in Discord with Developer Mode enabled)
# Production Channels
CHANNEL_ANNOUNCEMENTS=  # Channel for announcements
CHANNEL_LOGS=           # Channel for logging messages

# Development/Testing Channels
CHANNEL_TEST=           # Channel for testing messages
CHANNEL_DEBUG=          # Channel for debug messages

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Development Mode
DEBUG=true