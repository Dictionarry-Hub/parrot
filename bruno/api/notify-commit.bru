meta {
  name: Test GitHub Commit Notification
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/notify/commit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "repository": "Dictionarry-Hub/dictionarry",
    "branch": "main",
    "commit_hash": "a7f3d5e6b9c2d1e0f8a7b6c5d4e3f2a1",
    "message": "Refactor: Improve custom formats caching mechanism",
    "body": "This commit enhances the performance of custom formats by implementing a more efficient caching strategy. Key changes:\n\n- Replaced in-memory cache with Redis for better scalability\n- Added time-based invalidation for cached format definitions\n- Implemented background refresh for frequently accessed formats\n- Added metrics for cache hit/miss rates\n\nThis should resolve the performance issues reported in #245 and #267.",
    "url": "https://github.com/Dictionarry-Hub/dictionarry/commit/a7f3d5e6b9c2d1e0f8a7b6c5d4e3f2a1",
    "created_at": "2025-03-08T18:30:45Z",
    "author": {
      "name": "santiagosayshey",
      "email": "dev@dictionarry.dev",
      "username": "santiagosayshey",
      "url": "https://github.com/santiagosayshey"
    },
    "changed_files": 8,
    "additions": 143,
    "deletions": 96
  }
}

assert {
  res.status: 200
  res.body.status: "success"
  res.body.message: "Commit notification sent"
}