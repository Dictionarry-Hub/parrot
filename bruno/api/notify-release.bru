meta {
  name: Test GitHub Release Notification
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/notify/release
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "repository": "Dictionarry-Hub/dictionarry",
    "version": "2.4.0",
    "tag_name": "v2.4.0",
    "name": "Custom Formats UI Overhaul",
    "body": "## What's New\n\n### 🚀 Features\n\n- **Custom Formats UI**: Complete redesign of the custom formats builder with a more intuitive UI\n- **Profile Builder**: Added ability to clone existing profiles as starting templates\n- **Database**: Improved performance for large quality profile collections\n- **Search**: Enhanced search capabilities with regex support and highlighting\n\n### 🐛 Bug Fixes\n\n- Fixed issue with quality profiles not saving correctly when multiple formats applied\n- Corrected sorting behavior in the profile list view\n- Resolved synchronization issues with Radarr/Sonarr instances\n- Fixed theme selection persistence across sessions\n\n### 📝 Documentation\n\n- Added comprehensive usage guides for the new custom formats UI\n- Updated API documentation for developers\n- Added troubleshooting steps for common configuration issues\n\n## Installation\n\nYou can install this release using Docker:\n\n```bash\ndocker pull dictionarryhub/dictionarry:2.4.0\n```\n\nOr download the binaries directly from the releases page.",
    "url": "https://github.com/Dictionarry-Hub/dictionarry/releases/tag/v2.4.0",
    "created_at": "2025-03-08T15:00:00Z",
    "authors": [
      {
        "name": "santiagosayshey",
        "email": "dev@dictionarry.dev",
        "username": "santiagosayshey",
        "url": "https://github.com/santiagosayshey"
      },
      {
        "name": "sam-chau",
        "username": "sam-chau",
        "url": "https://github.com/sam-chau"
      }
    ],
    "prerelease": false
  }
}

assert {
  res.status: 200
  res.body.status: "success"
}
